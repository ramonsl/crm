{
  "name": "coordena-plus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register --project tsconfig.server.json server.ts",
    "dev:next": "next dev",
    "build": "next build && tsc --project tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "start": "node dist/server.js",
    "start:next": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "seed:admin": "node scripts/seed-admin-neon.js",
    "seed:test": "node scripts/seed-test-user.js",
    "build:server": "tsc --project tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "migrate": "npx node-pg-migrate up",
    "migrate:down": "npx node-pg-migrate down",
    "migrate:test": "ts-node scripts/migrate-test.ts",
    "migrate:prod": "ts-node scripts/migrate.ts",
    "migrate:create": "ts-node scripts/create-migration.ts",
    "rollback": "ts-node scripts/rollback.ts",
    "rollback:test": "ts-node -r dotenv/config scripts/rollback.ts dotenv_config_path=.env.local"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "@wppconnect-team/wppconnect": "^1.37.11",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.16.1",
    "fs-extra": "^11.3.3",
    "jimp": "^1.6.0",
    "lucide-react": "^0.555.0",
    "next": "^16.0.10",
    "next-auth": "^5.0.0-beta.30",
    "puppeteer": "^24.35.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-qr-code": "^2.0.18",
    "recharts": "^3.5.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "unzipper": "^0.12.3",
    "uuid": "^9.0.1",
    "whatsapp-web.js": "^1.34.4",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5",
    "node-pg-migrate": "^8.0.4",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/node-pg-migrate": "^2.3.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.57.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5"
  }
}