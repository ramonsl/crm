{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "./dist",
        "noEmit": false,
        "isolatedModules": false,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "server.ts",
        "src/lib/socket/**/*"
    ],
    "exclude": [
        "node_modules",
        ".next",
        "dist"
    ]
}